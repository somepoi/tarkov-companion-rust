{
  "name": "tarkov-companion-rust",
  "private": true,
  "version": "2.13.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tiles:lighthouse": "node scripts/tile-lighthouse.mjs",
    "dev:desktop": "vite --mode desktop",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "dist:desktop": "npm run assets:check && npm run packs && npm run build:desktop && electron-builder --win nsis portable --publish never",
    "test": "vitest run",
    "scan:logs": "tsx scripts/scan-logs.ts",
    "tiles:fetch": "node scripts/fetch-lighthouse-source.mjs",
    "scan:fingerprints": "tsx scripts/build-scan-fingerprints.ts",
    "scan:check": "tsx scripts/scan-check-corrections.ts",
    "scan:test": "tsx scripts/scan-test.ts",
    "ocr:assets": "node scripts/fetch-ocr-assets.mjs",
    "assets:prepare": "npm run ocr:assets && npm run scan:fingerprints",
    "assets:check": "tsx scripts/check-content-assets.ts",
    "check:content": "tsc -p tsconfig.content.json",
    "notices": "node scripts/build-notices.mjs",
    "packs": "node scripts/build-packs.mjs",
    "dev:tauri-ui": "vite --mode tauri --port 1420 --strictPort",
    "build:tauri-ui": "tsc -b && vite build --mode tauri",
    "dev:tauri": "node scripts/native.mjs tauri dev",
    "build:tauri": "npm run assets:check && npm run notices && npm run notices:rust && node scripts/native.mjs tauri build",
    "build:tauri:staged": "node scripts/build-staged-updates.mjs",
    "build:tauri:offline": "npm run build:tauri -- --config src-tauri/tauri.offline.conf.json --bundles nsis --ci",
    "updates:prepare": "node scripts/native.mjs cargo run --bin prepare-update --features staged-updates --",
    "notices:rust": "node scripts/build-rust-notices.mjs",
    "check:rust": "node scripts/native.mjs cargo check --workspace",
    "lint:rust": "node scripts/native.mjs cargo clippy --workspace -- -D warnings",
    "bench:desktop": "node scripts/bench/desktop-baseline.mjs",
    "bench:scan": "tsx scripts/bench/scan-baseline.ts",
    "icons:windows": "node scripts/build-windows-icon.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.50.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "productName": "Tarkov Companion Rust",
  "description": "Local-first Escape from Tarkov PvE companion and stash manager",
  "author": "David",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "io.github.somepoi.tarkov-companion-rust",
    "productName": "Tarkov Companion Rust",
    "copyright": "Copyright (C) 2026 David04-09. Free software under the GNU GPL v3 or later. Not affiliated with Battlestate Games.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!dist/tiles/**",
      "!dist/scan/**",
      "dist-electron/**",
      "build/icon.png",
      "build/tray.png",
      "package.json",
      "!node_modules/**/*.{md,map,ts}"
    ],
    "asarUnpack": [
      "build/**"
    ],
    "publish": null,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "TarkovCompanionRust-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tarkov Companion Rust",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "TarkovCompanionRust-Setup-${version}.${ext}",
      "guid": "5492dde8-2462-4b54-9ddf-66e53df5cef3"
    },
    "portable": {
      "artifactName": "TarkovCompanionRust-${version}-portable.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ]
  },
  "homepage": "https://github.com/somepoi/tarkov-companion-rust",
  "repository": {
    "type": "git",
    "url": "https://github.com/somepoi/tarkov-companion-rust.git"
  },
  "license": "GPL-3.0-or-later",
  "companion": {
    "dataDirectoryName": "Tarkov Companion Rust",
    "artifactPrefix": "TarkovCompanionRust",
    "updaterCacheDirectoryName": "tarkov-companion-rust-updater",
    "updatesEnabled": false,
    "automaticCleanupEnabled": false,
    "contentPackRepository": "https://github.com/somepoi/tarkov-companion-rust"
  }
}
