{
  "name": "tarkov-companion-rust",
  "private": true,
  "version": "2.13.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:tauri --",
    "build": "npm run build:tauri --",
    "lint": "oxlint",
    "preview": "vite preview",
    "tiles:lighthouse": "node scripts/tile-lighthouse.mjs",
    "dev:desktop": "npm run dev:tauri --",
    "build:desktop": "npm run build:tauri --",
    "dist:desktop": "npm run build:tauri --",
    "test": "vitest run",
    "scan:logs": "tsx scripts/scan-logs.ts",
    "tiles:fetch": "node scripts/fetch-lighthouse-source.mjs",
    "scan:fingerprints": "tsx scripts/build-scan-fingerprints.ts",
    "scan:check": "tsx scripts/scan-check-corrections.ts",
    "scan:test": "tsx scripts/scan-test.ts",
    "ocr:assets": "node scripts/fetch-ocr-assets.mjs",
    "assets:prepare": "npm run ocr:assets && npm run scan:fingerprints",
    "assets:check": "tsx scripts/check-content-assets.ts",
    "check:content": "tsc -p tsconfig.content.json",
    "notices": "node scripts/build-notices.mjs",
    "packs": "node scripts/build-packs.mjs",
    "dev:tauri-ui": "vite --mode tauri --port 1420 --strictPort",
    "build:tauri-ui": "tsc -b && vite build --mode tauri",
    "dev:tauri": "node scripts/native.mjs tauri dev --config src-tauri/tauri.dev.conf.json",
    "build:tauri": "npm run assets:check && npm run packs && npm run notices && npm run notices:rust && node scripts/native.mjs tauri build",
    "build:tauri:staged": "node scripts/build-staged-updates.mjs",
    "build:tauri:offline": "npm run build:tauri -- --config src-tauri/tauri.offline.conf.json --bundles nsis --ci",
    "updates:prepare": "node scripts/native.mjs cargo run --bin prepare-update --features staged-updates --",
    "notices:rust": "node scripts/build-rust-notices.mjs",
    "check:rust": "node scripts/native.mjs cargo check --workspace",
    "lint:rust": "node scripts/native.mjs cargo clippy --workspace -- -D warnings",
    "bench:desktop": "node scripts/bench/desktop-baseline.mjs",
    "bench:scan": "tsx scripts/bench/scan-baseline.ts",
    "icons:windows": "node scripts/build-windows-icon.mjs",
    "dev:web": "vite",
    "build:web": "tsc -b && vite build"
  },
  "devDependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.50.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "productName": "Tarkov Companion Rust",
  "description": "Local-first Escape from Tarkov PvE companion and stash manager",
  "author": "David",
  "homepage": "https://github.com/somepoi/tarkov-companion-rust",
  "repository": {
    "type": "git",
    "url": "https://github.com/somepoi/tarkov-companion-rust.git"
  },
  "license": "GPL-3.0-or-later"
}
